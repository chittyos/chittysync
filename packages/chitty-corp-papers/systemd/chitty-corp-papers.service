[Unit]
Description=Chitty Corporate Papers & Financials Sync Workload
After=network-online.target

[Service]
Type=oneshot
User=chittysync
Group=chittysync
WorkingDirectory=/home/ubuntu/projects/worktrees/migration-chittysync/packages/chitty-corp-papers

# Secure credential injection
# Load the encrypted bootstrap token so it is exposed as a plaintext file
# under $CREDENTIALS_DIRECTORY
LoadCredentialEncrypted=chittysecrets_bootstrap:/etc/chittystorage/creds/chittysecrets_bootstrap.cred

# Expose the loaded credentials as environment variables to the Node process
Environment=CHITTYSECRETS_BOOTSTRAP_TOKEN_FILE=%d/chittysecrets_bootstrap

ExecStart=/usr/bin/npm run sync

# Hardening
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes

[Install]
WantedBy=multi-user.target
